ARG PROBE_IMAGE=toho-worker-probe
FROM ${PROBE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends pulseaudio pulseaudio-utils scrot x11-utils \
    && rm -rf /var/lib/apt/lists/*

COPY run-th14-trial.sh trial-clock.c /probe/
RUN chmod +x /probe/run-th14-trial.sh \
    && i686-w64-mingw32-gcc-posix -Wall -Wextra -Werror -O2 /probe/trial-clock.c -o /probe/trial-clock.exe -luser32
ENTRYPOINT ["/probe/run-th14-trial.sh"]
