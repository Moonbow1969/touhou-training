ARG PROBE_IMAGE=toho-worker-probe
FROM ${PROBE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends pulseaudio pulseaudio-utils scrot x11-utils \
    && rm -rf /var/lib/apt/lists/*

COPY run-th14-trial.sh /probe/run-th14-trial.sh
RUN chmod +x /probe/run-th14-trial.sh
ENTRYPOINT ["/probe/run-th14-trial.sh"]
